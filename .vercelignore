# Vercel Deployment Ignore Rules
.git/
.github/
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3
*.zip
*.tar.gz
*.log
tests/
reports/evaluation/*.png
reports/evaluation/*.svg
reports/evaluation/external/*.csv
reports/evaluation/external/*.evtx
reports/evaluation/external/raw*
!reports/evaluation/external/external_combined_summary.json
docs/
artifacts/
scratch/
.pytest_cache/
.coverage
htmlcov/

