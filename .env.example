# ForensicShield AI - Production & Development Environment Configuration
# Copy this file to .env and configure appropriate values.
# NEVER commit .env or private credentials to version control.

# Flask Application Settings
FLASK_APP=wsgi:app
FLASK_ENV=production
DEBUG=0
PORT=5000
HOST=127.0.0.1

# Session Security (REQUIRED IN PRODUCTION: Minimum 32-character random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FORENSICSHIELD_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-in-production

# Database Configuration (Neon / Supabase / PostgreSQL)
# When set, the application uses managed PostgreSQL with full serverless persistence.
# If unset or empty, the application uses local SQLite storage (data/forensicshield.db).
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/forensicshield?sslmode=require

# Rate Limiter Shared Storage
# In distributed/serverless multi-worker cloud production, set to your Redis instance:
# e.g., redis://default:<password>@<host>:6379 or Upstash Redis URL
# In local development, defaults to memory://
RATELIMIT_STORAGE_URI=memory://
FORENSICSHIELD_RATELIMIT_STORAGE=memory://

# HTTPS & Cookie Security (Set to 1 when serving over HTTPS/TLS, e.g. on Vercel)
FORENSICSHIELD_HTTPS=1

# Demonstration Mode Security Settings
# In public web publication, keep 0 to permanently disable arbitrary client file uploads.
# Set to 1 only in isolated local academic laboratory environments.
FORENSICSHIELD_ALLOW_LOCAL_FILE_UPLOAD=0
